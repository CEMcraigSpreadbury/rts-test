#!/usr/bin/env python
"""ArmySim - the native unit simulation, built as a GDExtension.

godot-cpp has no 4.7 branch, so its bindings are generated from an
extension_api.json dumped out of the shipping Godot 4.7 binary (native/api/).
That keeps the bindings exactly in step with the engine we run against.

    cd native
    python -m SCons platform=windows target=template_debug custom_api_file=api/extension_api.json -j12
    python -m SCons platform=windows target=template_release custom_api_file=api/extension_api.json -j12
"""

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
env.Append(CPPDEFINES=["ARMY_PROFILING=1"])

if env.get("is_msvc", False) or env["CC"] == "cl":
    # The sim's hot loops are float-heavy; AVX2 is a safe floor for a post-2015 PC.
    env.Append(CXXFLAGS=["/fp:fast", "/std:c++20"])
    if env["target"] != "template_debug":
        env.Append(CXXFLAGS=["/arch:AVX2"])
else:
    env.Append(CXXFLAGS=["-std=c++20", "-ffast-math"])
    if env["target"] != "template_debug":
        env.Append(CXXFLAGS=["-mavx2", "-mfma"])

sources = Glob("src/*.cpp")

lib_path = "../addons/army_sim/bin/libarmysim{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
library = env.SharedLibrary(lib_path, source=sources)
Default(library)
