label = "Barracks"

[sub_resource type="Resource" id="have_houses"]
script = ExtResource("cond_buildings")
building_name = "House"
count = 2
label = "Houses"

[sub_resource type="Resource" id="hold_time"]
script = ExtResource("cond_time")
seconds = 480.0
label = "Held"

[sub_resource type="Resource" id="camp_burned_keep"]
script = ExtResource("cond_eliminate")
slot_index = 3
buildings_only = true
label = "Camp burned"

[sub_resource type="Resource" id="camp_burned"]
script = ExtResource("cond_eliminate")
slot_index = 3
buildings_only = true
label = "Camp burned"

[sub_resource type="Resource" id="beacon_lost"]
script = ExtResource("cond_destroy")
target_names = Array[String](["Beacon"])
label = "Beacon destroyed"

[sub_resource type="Resource" id="wave_one_timer"]
script = ExtResource("cond_time")
seconds = 150.0

[sub_resource type="Resource" id="wave_two_timer"]
script = ExtResource("cond_time")
seconds = 120.0

[sub_resource type="Resource" id="wave_three_timer"]
script = ExtResource("cond_time")
seconds = 120.0

[sub_resource type="Resource" id="say_elder_open"]
script = ExtResource("act_dialogue")
speaker = "Elder Maren"
text = "Thank the gods you came, my lord. Beastmen came out of the western woods two nights past and put the outer farms to the torch. Emberford still stands, and so does the beacon."
speaker_scene = ExtResource("villager")

[sub_resource type="Resource" id="say_captain_open"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "If that beacon falls, Aldmere never hears of this. Raise a Barracks and two Houses, and have men at Emberford before the Beastmen come back."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="mark_emberford"]
script = ExtResource("act_marker")
at = &"Emberford"
marker_id = &"emberford"
radius = 9.0

[sub_resource type="Resource" id="clear_emberford_marker"]
script = ExtResource("act_marker")
at = &"Emberford"
marker_id = &"emberford"
clear = true

[sub_resource type="Resource" id="ping_west_road"]
script = ExtResource("act_ping")
at = &"WestRoad"
hostile = true

[sub_resource type="Resource" id="say_wave_one"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "Movement on the western road — a handful of raiders, making for the village. Meet them before they reach it."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="wave_one_warriors"]
script = ExtResource("act_spawn")
unit_scene = ExtResource("warrior")
count = 1
slot_index = 3
at = &"WestRoad"
attack_move_to = &"Emberford"

[sub_resource type="Resource" id="wave_one_raiders"]
script = ExtResource("act_spawn")
unit_scene = ExtResource("raider")
count = 2
slot_index = 3
at = &"WestRoad"
attack_move_to = &"Emberford"

[sub_resource type="Resource" id="say_wave_two"]
script = ExtResource("act_dialogue")
speaker = "Elder Maren"
text = "More of them on the road! They know the beacon is the only voice we have."
speaker_scene = ExtResource("villager")

[sub_resource type="Resource" id="wave_two_warriors"]
script = ExtResource("act_spawn")
unit_scene = ExtResource("warrior")
count = 2
slot_index = 3
at = &"WestRoad"
attack_move_to = &"Emberford"

[sub_resource type="Resource" id="wave_two_raiders"]
script = ExtResource("act_spawn")
unit_scene = ExtResource("raider")
count = 2
slot_index = 3
at = &"WestRoad"
attack_move_to = &"Emberford"

[sub_resource type="Resource" id="say_wave_three"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "That is no raiding party — that is a warband, with shamans behind it. Every man you have to Emberford!"
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="wave_three_warriors"]
script = ExtResource("act_spawn")
unit_scene = ExtResource("warrior")
count = 3
slot_index = 3
at = &"WestRoad"
attack_move_to = &"Emberford"

[sub_resource type="Resource" id="wave_three_raiders"]
script = ExtResource("act_spawn")
unit_scene = ExtResource("raider")
count = 2
slot_index = 3
at = &"WestRoad"
attack_move_to = &"Emberford"

[sub_resource type="Resource" id="wave_three_druids"]
script = ExtResource("act_spawn")
unit_scene = ExtResource("druid")
count = 2
slot_index = 3
at = &"WestRoad"
attack_move_to = &"Emberford"

[sub_resource type="Resource" id="pan_to_camp"]
script = ExtResource("act_camera")
at = &"BeastmenCamp"

[sub_resource type="Resource" id="reveal_camp"]
script = ExtResource("act_reveal")
at = &"BeastmenCamp"
seconds = 30.0

[sub_resource type="Resource" id="mark_camp"]
script = ExtResource("act_marker")
at = &"BeastmenCamp"
marker_id = &"camp"
radius = 10.0

[sub_resource type="Resource" id="clear_camp_marker"]
script = ExtResource("act_marker")
at = &"BeastmenCamp"
marker_id = &"camp"
clear = true

[sub_resource type="Resource" id="say_scout"]
script = ExtResource("act_dialogue")
speaker = "Scout"
text = "I followed their tracks north, my lord. Their camp is in the old clearing past the woods — pens, cookfires, and more of them than we feared."
speaker_scene = ExtResource("archer")

[sub_resource type="Resource" id="say_captain_burn"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "Then we finish it where it started. The village has sent what it can spare — march north and burn every pen in that camp."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="neighbour_to_camp"]
script = ExtResource("act_ai_mode")
slot_index = 1
mode = 2
attack_at = &"BeastmenCamp"

[sub_resource type="Resource" id="village_reward"]
script = ExtResource("act_give")
amounts = Array[ExtResource("cost_script")]([SubResource("reward_wood"), SubResource("reward_gold")])

[sub_resource type="Resource" id="say_elder_end"]
script = ExtResource("act_dialogue")
speaker = "Elder Maren"
text = "Smoke over the northern woods, and none of it ours. Emberford will remember this, my lord."
speaker_scene = ExtResource("villager")

[sub_resource type="Resource" id="say_captain_end"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "They fought under a banner I have only seen in the old histories — a black sun. Vorgrath's sign. Light every beacon from here to the capital."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="win"]
script = ExtResource("act_end")
victory = true

[sub_resource type="Resource" id="say_beacon_lost"]
script = ExtResource("act_dialogue")
speaker = "Elder Maren"
text = "The beacon is down... No one in Aldmere will ever see it now."
speaker_scene = ExtResource("villager")

[sub_resource type="Resource" id="lose"]
script = ExtResource("act_end")
victory = false

[node name="Main" instance=ExtResource("map")]

[node name="Scenario" type="Node3D" parent="."]
script = ExtResource("scenario_script")
scenario_name = "Emberford"
briefing_title = "Emberford"
briefing_text = "The Long Peace ended two nights ago, when Beastmen came out of the western woods and burned the farms around Emberford. The village still stands, and so does its beacon — the only way word of this can reach Aldmere. Hold Emberford, then find where the raiders came from and burn it."

