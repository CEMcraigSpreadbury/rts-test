[node name="Quests" type="Node" parent="Scenario"]

[node name="RaiseBarracks" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "Raise a Barracks"
conditions = Array[ExtResource("condition_script")]([SubResource("have_barracks")])
on_start = Array[ExtResource("action_script")]([SubResource("say_elder_open"), SubResource("say_captain_open"), SubResource("mark_emberford")])

[node name="BuildHouses" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "Build two Houses"
conditions = Array[ExtResource("condition_script")]([SubResource("have_houses")])

[node name="HoldEmberford" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "Hold Emberford"
conditions = Array[ExtResource("condition_script")]([SubResource("hold_time")])
on_complete = Array[ExtResource("action_script")]([SubResource("clear_emberford_marker"), SubResource("pan_to_camp"), SubResource("reveal_camp"), SubResource("mark_camp"), SubResource("neighbour_to_camp"), SubResource("village_reward"), SubResource("say_scout"), SubResource("say_captain_burn")])

[node name="KeepTheBeacon" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "Keep the beacon standing"
conditions = Array[ExtResource("condition_script")]([SubResource("camp_burned_keep")])
fail_conditions = Array[ExtResource("condition_script")]([SubResource("beacon_lost")])
on_fail = Array[ExtResource("action_script")]([SubResource("say_beacon_lost"), SubResource("lose")])

[node name="BurnTheCamp" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "Burn the Beastmen camp"
requires = Array[NodePath]([NodePath("HoldEmberford")])
conditions = Array[ExtResource("condition_script")]([SubResource("camp_burned")])
on_complete = Array[ExtResource("action_script")]([SubResource("clear_camp_marker"), SubResource("say_elder_end"), SubResource("say_captain_end"), SubResource("win")])

[node name="WaveOne" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "First raid"
hidden = true
conditions = Array[ExtResource("condition_script")]([SubResource("wave_one_timer")])
on_complete = Array[ExtResource("action_script")]([SubResource("say_wave_one"), SubResource("ping_west_road"), SubResource("wave_one_warriors"), SubResource("wave_one_raiders")])

[node name="WaveTwo" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "Second raid"
hidden = true
requires = Array[NodePath]([NodePath("WaveOne")])
conditions = Array[ExtResource("condition_script")]([SubResource("wave_two_timer")])
on_complete = Array[ExtResource("action_script")]([SubResource("say_wave_two"), SubResource("ping_west_road"), SubResource("wave_two_warriors"), SubResource("wave_two_raiders")])

[node name="WaveThree" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "The warband"
hidden = true
requires = Array[NodePath]([NodePath("WaveTwo")])
conditions = Array[ExtResource("condition_script")]([SubResource("wave_three_timer")])
on_complete = Array[ExtResource("action_script")]([SubResource("say_wave_three"), SubResource("ping_west_road"), SubResource("wave_three_warriors"), SubResource("wave_three_raiders"), SubResource("wave_three_druids")])
