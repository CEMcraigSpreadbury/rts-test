scenario_name = "The Pretender"
briefing_title = "The Pretender"
briefing_text = "Lord Varric has named himself Lord of the March and raised a holding on the far side of the Four Kingdoms. It was his gold that armed Grimhold. Take the land before he does, then burn his Town Center."

