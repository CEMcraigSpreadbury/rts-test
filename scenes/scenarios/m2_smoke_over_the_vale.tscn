[node name="Scenario" type="Node3D" parent="."]
script = ExtResource("scenario")
scenario_name = "Smoke over the Vale"
briefing_title = "Smoke over the Vale"
briefing_text = "The Beastmen of Grimhold have come down into Aldmere Vale, and its villages are burning. Win the Vale's settlements to your banner before the raiders take them, then break Grimhold itself."

