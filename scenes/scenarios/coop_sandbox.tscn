[node name="Zones" type="Node3D" parent="Scenario"]

[node name="Markers" type="Node3D" parent="Scenario"]

[node name="Quests" type="Node" parent="Scenario"]

[node name="RazeTheCamp" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "Raze the raiders' camp"
conditions = Array[ExtResource("condition_script")]([SubResource("raze_the_camp")])
on_start = Array[ExtResource("action_script")]([SubResource("say_open")])
on_complete = Array[ExtResource("action_script")]([SubResource("win")])
