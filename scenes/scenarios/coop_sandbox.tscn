[ext_resource type="PackedScene" path="res://scenes/units/soldier_unit.tscn" id="soldier"]

[sub_resource type="Resource" id="raze_the_camp"]
script = ExtResource("cond_eliminate")
label = "Enemy buildings destroyed"
slot_index = 2
buildings_only = true

[sub_resource type="Resource" id="say_open"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "The raiders have made a camp to the south, my lord. You hold the north road, your neighbour the west — take it apart between you."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="win"]
script = ExtResource("act_end")
victory = true

[node name="Main" instance=ExtResource("map")]

[node name="Scenario" type="Node3D" parent="."]
script = ExtResource("scenario_script")
scenario_name = "Two Lords"
briefing_title = "Two Lords"
briefing_text = "Two neighbouring lords hold the north of the valley. Raze the camp to the south between you. Played alone, the second seat is taken by an allied AI."

[node name="Slots" type="Node3D" parent="Scenario"]

[node name="FirstLord" type="Node3D" parent="Scenario/Slots"]
