[sub_resource type="Resource" id="say_captain_open"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "They are all around us, my lord — north and east, more than I can count. The King's riders are on the south road; until they come, the walls are all we have."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="say_captain_walls"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "Keep the gates shut and the towers manned. Anything that gets over the wall, meet it in the square."
speaker_scene = ExtResource("soldier")

