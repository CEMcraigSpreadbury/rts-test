scenario_name = "The Siege of Aldmere"
briefing_title = "The Siege of Aldmere"
briefing_text = "The Beastmen have come out of the woods in their thousands, and a Skeleton Dragon flies before them. The capital's walls must hold until the King's riders return from the south — then the siege must be broken for good."

