[sub_resource type="Resource" id="say_captain_won"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "The siege is broken. Vorgrath threw his army at our walls, and it broke on them."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="say_marshal_won"]
script = ExtResource("act_dialogue")
speaker = "Marshal Aldric"
text = "Then we take the war to him. The King marches for the Ashen Peaks, and he wants you at his side."
speaker_scene = ExtResource("cavalry")

[sub_resource type="Resource" id="win"]
script = ExtResource("act_end")
victory = true

