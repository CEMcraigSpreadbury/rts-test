[sub_resource type="Resource" id="say_marshal"]
script = ExtResource("act_dialogue")
speaker = "Marshal Aldric"
text = "Aldmere! The King's riders are here. Point us at them, my lord."
speaker_scene = ExtResource("cavalry")

[sub_resource type="Resource" id="say_captain_break"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "Now we break them. Burn both camps, and bring that dragon down if it still flies."
speaker_scene = ExtResource("soldier")

