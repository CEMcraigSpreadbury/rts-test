[sub_resource type="Resource" id="start_wood"]
script = ExtResource("cost_script")
resource_type = ExtResource("wood_type")
amount = 400

[sub_resource type="Resource" id="start_gold"]
script = ExtResource("cost_script")
resource_type = ExtResource("gold_type")
amount = 300

[sub_resource type="Resource" id="mods_player"]
script = ExtResource("mods_script")
allowed_buildings = Array[String](["House", "Barracks"])
research_tier_cap = 0
locked_hud = Array[String](["research", "formations", "control_groups"])

[sub_resource type="Resource" id="have_barracks"]
script = ExtResource("cond_buildings")
building_name = "Barracks"
label = "Barracks built"

[sub_resource type="Resource" id="say_barracks"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "Beastmen on the old road, my lord — three of them, and more behind. Build a Barracks: press B, choose it, and set it down near the hall."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="trained_three"]
script = ExtResource("cond_trained")
unit_name = "Soldier"
count = 3
label = "Soldiers trained"

[sub_resource type="Resource" id="say_train"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "Select the Barracks and train three soldiers. Ctrl and a number binds them to a group; the F1 to F3 keys set how they stand."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="teach_orders"]
script = ExtResource("act_unlock")
unlock_hud = Array[String](["formations", "control_groups"])

[sub_resource type="Resource" id="raiders_dead"]
script = ExtResource("cond_destroy")
target_names = Array[String](["Raider1", "Raider2", "Raider3"])
label = "Raiders driven off"

[sub_resource type="Resource" id="say_attack"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "Now drive them off. Select your soldiers and right-click a raider to set on it, or press F and click the ground to advance fighting whatever they meet."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="mark_raiders"]
script = ExtResource("act_marker")
at = &"RaidersCamp"
marker_id = &"raiders"
radius = 7.0

[sub_resource type="Resource" id="clear_raider_marker"]
script = ExtResource("act_marker")
at = &"RaidersCamp"
marker_id = &"raiders"
clear = true

[sub_resource type="Resource" id="say_done"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "The road is ours again. Word should go to Aldmere all the same — beastmen have not come this far west in living memory."
speaker_scene = ExtResource("soldier")

[sub_resource type="Resource" id="win"]
script = ExtResource("act_end")

