[node name="TrainSoldiers" type="Node" parent="Scenario/Quests" index="1" unique_id=1816099426]
script = ExtResource("step_script")
title = "Train three soldiers"
requires = Array[NodePath]([NodePath("BuildBarracks")])
conditions = Array[ExtResource("condition_script")]([SubResource("trained_three")])
on_start = Array[ExtResource("action_script")]([SubResource("say_train"), SubResource("teach_orders")])

[node name="DriveThemOff" type="Node" parent="Scenario/Quests" index="2" unique_id=1688571785]
script = ExtResource("step_script")
title = "Drive off the raiders"
requires = Array[NodePath]([NodePath("TrainSoldiers")])
conditions = Array[ExtResource("condition_script")]([SubResource("raiders_dead")])
on_start = Array[ExtResource("action_script")]([SubResource("say_attack"), SubResource("mark_raiders")])
on_complete = Array[ExtResource("action_script")]([SubResource("clear_raider_marker"), SubResource("say_done"), SubResource("win")])
