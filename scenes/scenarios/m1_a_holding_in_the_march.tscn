[sub_resource type="Resource" id="a_dialogue_7"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "Welcome to the March, my lord. Before anything else, look over what you have. W, A, S and D move the view, Q and E turn it, and the mouse wheel brings it closer or further off."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

[sub_resource type="Resource" id="c_input_8"]
script = ExtResource("c_input")
kind = "select_units"
detail = "Villager"

[sub_resource type="Resource" id="a_dialogue_9"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "Those are your villagers, by the Town Center. Click one to take charge of it, or drag a box around several at once."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

