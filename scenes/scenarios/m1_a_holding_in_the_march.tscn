[sub_resource type="Resource" id="a_dialogue_11"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "Everything here is built of wood. With villagers selected, right-click a tree: they cut it and carry it home to the Town Center by themselves. The idle villager button finds anyone left standing about."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

