script = ExtResource("c_trained")
unit_name = "Lord"
count = 1

[sub_resource type="Resource" id="a_highlight_36"]
script = ExtResource("a_highlight")
element = "unit_cards"
clear = true

[sub_resource type="Resource" id="cost_37"]
script = ExtResource("cost")
resource_type = ExtResource("gold")
amount = 150

[sub_resource type="Resource" id="a_give_38"]
script = ExtResource("a_give")
amounts = Array[ExtResource("cost")]([SubResource("cost_37")])

[sub_resource type="Resource" id="a_dialogue_39"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "A regiment fights harder and holds its nerve under a Lord. The Crown has sent gold for one: select the Town Center and raise him. You may keep one Lord, and one more for every two settlements you hold."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

[sub_resource type="Resource" id="c_regiments_40"]
script = ExtResource("c_regiments")
count = 1
in_lords_army = true

[sub_resource type="Resource" id="a_dialogue_41"]
script = ExtResource("a_dialogue")
speaker = "Captain Bram"
text = "Now put the men under him. Select the Lord and the regiment together and press J. The Lord's tab above the cards selects his whole army at once."
speaker_scene = ExtResource("unit_soldier")
pause_in_single_player = true

[sub_resource type="Resource" id="c_settlements_42"]
script = ExtResource("c_settlements")
settlement_names = Array[String](["Objective6"])
count = 1

[sub_resource type="Resource" id="a_marker_43"]
script = ExtResource("a_marker")
at = &"Brackenford"
marker_id = &"village"
radius = 12.0

[sub_resource type="Resource" id="a_ping_44"]
script = ExtResource("a_ping")
at = &"Brackenford"

[sub_resource type="Resource" id="a_dialogue_45"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "West of the hall, down the slope, lies Brackenford, a village of our own people. Its militia will not bow to a banner they have not seen win. Beat the garrison, then keep men standing in the village until your flag is raised."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

[sub_resource type="Resource" id="a_dialogue_46"]
script = ExtResource("a_dialogue")
speaker = "Captain Bram"
text = "Right-click to march there, or press F and click to fight whatever we meet on the way."
speaker_scene = ExtResource("unit_soldier")
pause_in_single_player = true

[sub_resource type="Resource" id="a_marker_47"]
script = ExtResource("a_marker")
at = &"Brackenford"
marker_id = &"village"
radius = 12.0
clear = true

[sub_resource type="Resource" id="a_dialogue_48"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "Brackenford is yours. Its hall asks what becomes of the place: Occupy keeps it and its people; Raze burns it for a little gold. Select the hall and choose Occupy."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

[sub_resource type="Resource" id="c_buildings_49"]
script = ExtResource("c_buildings")
building_name = "Granary"
count = 1

[sub_resource type="Resource" id="a_dialogue_50"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "A settlement builds in slots of its own, with no villagers needed. Select the village hall and put a Granary in a slot: it pays food by itself. A Barracks there would recruit Brackenford's own people."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

[sub_resource type="Resource" id="a_dialogue_51"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "That is a holding in good order. Villages grow into Towns and Cities with more slots, and every two settlements let you keep another Lord. When you play alone, Pause and the - and = keys slow or quicken the day."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

[sub_resource type="Resource" id="a_dialogue_52"]
script = ExtResource("a_dialogue")
speaker = "Captain Bram"
text = "A rider came in while you worked, my lord. Smoke over Aldmere Vale: the Beastmen of Grimhold are burning the villages. The Crown wants you there."
speaker_scene = ExtResource("unit_soldier")

[sub_resource type="Resource" id="a_end_53"]
script = ExtResource("a_end")
victory = true

[node name="Main" instance=ExtResource("map")]

[node name="Scenario" type="Node3D" parent="."]
script = ExtResource("scenario")
scenario_name = "A Holding in the March"
briefing_title = "A Holding in the March"
briefing_text = "The Crown has granted you the March: a wild borderland of villages and camps that answer to no one. You have a hall, a handful of villagers and a steward who knows the work. Learn to run a holding, raise an army, and bring your first village under your banner."

