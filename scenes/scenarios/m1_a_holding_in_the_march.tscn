resource_type = ExtResource("gold")
amount = 30

[sub_resource type="Resource" id="a_dialogue_22"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "A Mine needs miners. Select a few villagers and right-click the Mine, and they will bring the gold home."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

[sub_resource type="Resource" id="c_buildings_23"]
script = ExtResource("c_buildings")
building_name = "Mill"
count = 1

[sub_resource type="Resource" id="a_dialogue_24"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "Soldiers eat, and food comes from the fields. Build a Mill (B, then P) where there is open ground around it. Its fields are laid out once it stands; right-click one with villagers and they will sow it, tend it and bring in the harvest."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

[sub_resource type="Resource" id="c_trained_25"]
script = ExtResource("c_trained")
unit_name = "Villager"
count = 2

[sub_resource type="Resource" id="a_dialogue_26"]
script = ExtResource("a_dialogue")
speaker = "Steward Edda"
text = "More hands, more of everything. Select the Town Center and train two villagers. Each costs a little wood and food."
speaker_scene = ExtResource("unit_villager")
pause_in_single_player = true

[sub_resource type="Resource" id="c_buildings_27"]
script = ExtResource("c_buildings")
building_name = "Barracks"
count = 1

[sub_resource type="Resource" id="a_unlocks_28"]
script = ExtResource("a_unlocks")
unlock_buildings = Array[String](["Barracks"])

[sub_resource type="Resource" id="a_dialogue_29"]
script = ExtResource("a_dialogue")
speaker = "Captain Bram"
text = "Captain Bram, my lord, at your service, as soon as there is somewhere to serve from. Have a villager raise a Barracks: B, then B again."
speaker_scene = ExtResource("unit_soldier")
pause_in_single_player = true

[sub_resource type="Resource" id="c_units_30"]
script = ExtResource("c_units")
unit_name = "Soldier"
count = 12

[sub_resource type="Resource" id="a_dialogue_31"]
script = ExtResource("a_dialogue")
speaker = "Captain Bram"
text = "Select the Barracks and click Soldier once for each man. Right-click the ground while it is selected and new men will gather there. Mind the food: every soldier eats, and what they eat a minute shows beside your food."
speaker_scene = ExtResource("unit_soldier")
pause_in_single_player = true

[sub_resource type="Resource" id="c_regiments_32"]
script = ExtResource("c_regiments")
count = 1

[sub_resource type="Resource" id="a_dialogue_33"]
script = ExtResource("a_dialogue")
speaker = "Captain Bram"
text = "Loose men are a crowd. Select the soldiers and press N to form them into a regiment. It is raised in ranks of six, every man keeps his place in the line, and its card appears along the bottom of the screen."
speaker_scene = ExtResource("unit_soldier")
pause_in_single_player = true

[sub_resource type="Resource" id="a_highlight_34"]
script = ExtResource("a_highlight")
element = "unit_cards"

