slot_index = -1

[sub_resource type="Resource" id="have_two_soldiers"]
script = ExtResource("cond_have_units")
label = "Soldiers mustered"
unit_name = "Soldier"
count = 2

[sub_resource type="Resource" id="unlock_stables"]
script = ExtResource("act_unlock")
slot_index = -1
unlock_buildings = Array[String](["Stables"])
research_tier_cap = -2

[sub_resource type="Resource" id="kill_garrison"]
script = ExtResource("cond_destroy")
label = "Garrison cleared"
target_names = Array[String](["Guard1", "Guard2"])

[sub_resource type="Resource" id="win"]
script = ExtResource("act_end")
victory = true

[sub_resource type="Resource" id="line_captain"]
script = ExtResource("act_dialogue")
speaker = "Captain"
text = "The muster is in, my lord. Two of the guard stand ready at the crossroads."
speaker_scene = ExtResource("soldier")
pause_in_single_player = false

[sub_resource type="Resource" id="line_scout"]
script = ExtResource("act_dialogue")
speaker = "Scout"
text = "Beastmen hold the old road west of here. Clear them out and the way is ours."
speaker_scene = ExtResource("soldier")
pause_in_single_player = false

[sub_resource type="Resource" id="pan_crossroads"]
script = ExtResource("act_camera")
at = &"Crossroads"

[sub_resource type="Resource" id="ping_crossroads"]
script = ExtResource("act_ping")
at = &"Crossroads"
hostile = false

[sub_resource type="Resource" id="mark_crossroads"]
script = ExtResource("act_marker")
at = &"Crossroads"
marker_id = &"muster"
radius = 4.0
clear = false

[sub_resource type="Resource" id="reveal_crossroads"]
script = ExtResource("act_reveal")
at = &"Crossroads"
radius = 0.0
seconds = 20.0

[sub_resource type="Resource" id="clear_marker"]
script = ExtResource("act_marker")
at = &"Crossroads"
marker_id = &"muster"
radius = 4.0
clear = true

[sub_resource type="Resource" id="move_the_camera"]
script = ExtResource("cond_input")
label = "Camera moved"
kind = "camera_move"
count = 1

[sub_resource type="Resource" id="point_at_minimap"]
script = ExtResource("act_highlight")
element = "minimap"
clear = false

[sub_resource type="Resource" id="stop_pointing"]
script = ExtResource("act_highlight")
element = "minimap"
clear = true

[sub_resource type="Resource" id="teach_research"]
script = ExtResource("act_unlock")
slot_index = -1
research_tier_cap = -2
unlock_hud = Array[String](["research", "formations"])

[sub_resource type="Resource" id="brief_midway"]
script = ExtResource("act_briefing")
title = "The Long Peace Ends"
text = "Word comes from the border: the seal beneath the Ashen Peaks has failed. Vorgrath stirs, and the Beastmen answer him. Hold the crossroads, and send word to Aldmere."

