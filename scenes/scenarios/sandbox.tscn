locked_hud = Array[String](["research", "formations"])

[sub_resource type="Resource" id="wait_three"]
script = ExtResource("cond_elapsed")
label = "Reinforcements arrive"
seconds = 3.0

[sub_resource type="Resource" id="spawn_guard"]
script = ExtResource("act_spawn")
unit_scene = ExtResource("soldier")
count = 2
slot_index = 0
at = &"Crossroads"
spread = 2.0

[sub_resource type="Resource" id="give_gold"]
script = ExtResource("act_give")
