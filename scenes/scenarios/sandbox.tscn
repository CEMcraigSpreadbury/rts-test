[node name="Muster" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "Await the muster"
conditions = Array[ExtResource("condition_script")]([SubResource("wait_three")])
on_complete = Array[ExtResource("action_script")]([SubResource("spawn_guard"), SubResource("give_gold"), SubResource("line_captain"), SubResource("pan_crossroads"), SubResource("ping_crossroads"), SubResource("mark_crossroads"), SubResource("reveal_crossroads")])

[node name="Gather" type="Node" parent="Scenario/Quests"]
script = ExtResource("step_script")
title = "Gather two soldiers"
requires = Array[NodePath]([NodePath("Muster")])
conditions = Array[ExtResource("condition_script")]([SubResource("have_two_soldiers")])
