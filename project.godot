; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

"ï»¿config_version"=5

[application]

config/name="Crowns of Aldmere"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ResourceStockpile="*res://scripts/resource_stockpile.gd"
Population="*res://scripts/population.gd"
Network="*res://scripts/network_manager.gd"
Settings="*res://scripts/settings.gd"
UnitUpgrades="*res://scripts/unit_upgrades.gd"
UnitUnlocks="*res://scripts/unit_unlocks.gd"
Steamworks="*res://scripts/steamworks.gd"
UiDebugEditor="*res://scripts/ui_debug_editor.gd"
SceneLoader="*res://scripts/scene_loader.gd"

[debug]

ui_editor/enabled=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="res://assets/art/cursor_64.png"

[editor_plugins]

enabled=PackedStringArray("res://addons/TileMapLayer3D/plugin.cfg", "res://addons/grass_painter/plugin.cfg", "res://addons/godot-mcp/plugin.cfg", "res://addons/scenario_editor/plugin.cfg", "res://addons/icon_maker/plugin.cfg")

[gui]

timers/tooltip_delay_sec=0.15
theme/custom="res://assets/ui/theme/dark_ages_theme.tres"

[physics]

common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=2
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"

[shader_globals]

cloud_shadow_tex={
"type": "sampler2D",
"value": ""
}
cloud_shadow_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
cloud_shadow_strength={
"type": "float",
"value": 0.0
}
unit_night_lift={
"type": "float",
"value": 0.0
}
water_reflections={
"type": "bool",
"value": true
}
